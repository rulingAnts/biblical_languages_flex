<ExampleSentences>
<AStr ws="en">
<Run ws="en">You don't need to do anything. I will take care of it &lt;personally&gt;.; Instead of sending a representative, he is coming &lt;in person&gt;.; You can talk to him &lt;direct&gt;.</Run>
</AStr>
</ExampleSentences>
<ExampleWords>
<AUni ws="en">personally, in person, direct</AUni>
</ExampleWords>
