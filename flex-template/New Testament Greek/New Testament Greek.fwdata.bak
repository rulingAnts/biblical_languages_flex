<Description>
<AStr ws="en">
<Run ws="en">A part/whole relation establishes a link between the sense for the whole (e.g., room), and senses for the parts (e.g., ceiling, wall, floor).</Run>
</AStr>
</Description>
<ForeColor val="0" />
<Hidden val="False" />
<IsProtected val="False" />
